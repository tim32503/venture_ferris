    <meta name="description" content="">
    <meta name="author" content="">
      
    <title>勇闖摩天輪</title>

    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.firebase.com/libs/firebaseui/3.3.0/firebaseui.css" />
    <link rel="stylesheet" href="https://www.gstatic.com/firebasejs/ui/3.4.0/firebase-ui-auth.css" />
    
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.4.1/css/all.css" integrity="sha384-5sAR7xN1Nv6T6+dT2mhtzEpVJvfS3NScPQTrOxhwjIuvcA67KV2R5Jz6kr4abQsz" crossorigin="anonymous">

    <script src="https://www.gstatic.com/firebasejs/5.3.0/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/5.3.0/firebase-auth.js"></script>
    <script src="https://www.gstatic.com/firebasejs/5.3.0/firebase-database.js"></script>
    <script src="https://cdn.firebase.com/libs/firebaseui/3.3.0/firebaseui.js"></script>
    <script src="https://www.gstatic.com/firebasejs/ui/3.4.0/firebase-ui-auth__zh_tw.js"></script>
    <script src="https://code.jquery.com/jquery-3.3.1.min.js" integrity="sha256-FgpCb/KJQlLNfOu91ta32o/NMZxltwRo8QtmkMRdAu8=" crossorigin="anonymous"></script>
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js" integrity="sha256-VazP97ZCwtekAsvgPBSUwPFKdrwD3unUfSGVYrahUqU=" crossorigin="anonymous"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.3/umd/popper.min.js" integrity="sha384-ZMP7rVo3mIykV+2+9J3UJ46jBk0WLaUAdn689aCwoqbBJiSnjAK/l8WvCWPIPm49" crossorigin="anonymous"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.min.js" integrity="sha384-ChfqqxuZUCnJSK3+MXmPNIyE6ZbWh2IMqE241rYiqJxyMiZ6OW/JmZQ5stwEULTy" crossorigin="anonymous"></script>

    <%= stylesheet_link_tag "site" %>
    <%= javascript_include_tag "jquery.snap-puzzle.min" %>

    <script type="text/javascript">
      //JS-打字機效果
      function type(text, field){
        if($('#cursor_blink').length >= 1){
          $('#cursor_blink').remove();
        }
        
        field = field || "teletype";
        var cursor = "<span class='cursor-blink' id='cursor_blink'>_</span>";
        var telecopy = text;
        var counter = 0;
        $('#'+field).html(cursor);
        $('#'+field).removeAttr("hidden");
        var timer = setInterval(function(){
          $('#'+field).html(telecopy.substr(0, counter) + cursor);
          counter++;
          
          if(counter === telecopy.length +1){
            clearInterval(timer);
          }
        }, 100);
      }
    </script>

    <%= yield :head %>
  </head>

  <body>
    <%= yield %>
    
    <footer class="container-fluid">
      <div class="text-center">
        <p>遊戲設計/Escapeholics密室逃脫</p>
        <p>主辦單位/臺北市商業處、臺北市商圈產業聯合會</p>
        <p>指導單位/經濟部中小企業處</p>
        <br>
        <p class="ad">廣告</p>
      </div>	
    </footer>
    
    <script type="text/javascript">
      window.history.forward(1);
    </script>
  </body>
</html>
