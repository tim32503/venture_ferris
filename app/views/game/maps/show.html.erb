<% content_for :title, "遊戲地圖" %>
<% content_for :body_class, "bg-gradient-to-b! from-slate-900 via-slate-900 to-slate-800 text-slate-100!" %>

<%# Same active-question redirect as the home page (see game/home/show.html.erb
    and active_question_poll_controller.js) — legacy wheel_map1/2/3.php all ran
    the same questionIsStart()/BossIsStart() polls the home page did. %>
<main class="mx-auto! max-w-5xl! px-4! py-8! sm:py-12!"
      data-controller="active-question-poll"
      data-active-question-poll-url-value="<%= status_game_question_path(Question::FIRST_NUMBER) %>"
      data-active-question-poll-question-base-path-value="<%= question_redirect_base_path %>"
      data-active-question-poll-boss-base-path-value="<%= boss_redirect_base_path %>">

  <% back_path = @map_id == 2 ? game_current_map_path : game_root_path %>
  <%= link_to back_path,
        class: "fixed! left-4! top-4! z-10! inline-flex! h-11! w-11! items-center! justify-center! rounded-full! bg-slate-800/90! text-slate-100! ring-1! ring-white/10! shadow-lg! backdrop-blur! transition! hover:bg-slate-700! focus-visible:outline! focus-visible:outline-2! focus-visible:outline-offset-2! focus-visible:outline-amber-400!",
        id: "menubar", "aria-label": "返回" do %>
    <svg class="h-5! w-5!" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
    </svg>
  <% end %>

  <div class="mx-auto! max-w-5xl! rounded-xl! bg-slate-800/60! p-3! ring-1! ring-white/10! backdrop-blur! sm:p-4!">
    <div id="m<%= @map_id %>" class="mx-auto! overflow-hidden! rounded-lg!" style="position: relative; max-width: <%= @natural_width %>px;">
      <%= image_tag @image, class: "block! w-full!" %>
      <% @areas.each do |area| %>
        <%
          href = area[:to_map] ? game_map_path(area[:to_map]) : game_question_path(area[:number])
          solved = area[:number].present? && @completed_numbers.include?(area[:number])
          label = "#{area[:title]}#{" (已完成)" if solved}"
        %>
        <%= link_to "", href, class: "map-hotspot",
              style: "left: #{area[:left]}%; top: #{area[:top]}%; width: #{area[:width]}%; height: #{area[:height]}%;",
              title: label, "aria-label": label %>
      <% end %>
    </div>
  </div>

  <%# The legacy map views (wheel_map1/2/3.php) have no solved/unsolved styling
      at all — that list only exists on wheel_record.php (P4 scope). This line is
      a small UX addition built on Team#completed_question_numbers rather than a
      port of existing legacy behavior. %>
  <% if @completed_numbers.any? %>
    <p class="mx-auto! mt-4! max-w-5xl! rounded-lg! bg-slate-800/70! px-4! py-3! text-center! text-sm! text-emerald-300! ring-1! ring-emerald-500/30!">已完成關卡：第 <%= @completed_numbers.join("、") %> 題</p>
  <% end %>
</main>
