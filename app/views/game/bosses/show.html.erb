<% content_for :title, "魔王戰：#{@question.title}" %>
<% content_for :body_class, "bg-gradient-to-b! from-slate-900 via-slate-900 to-slate-800 text-slate-100!" %>

<%# boss.scss ships pre-built classes for this page (.boss-bg/.boss-grass/
    .mon0N/#counter/#bossHP/.ripple) but isn't linked from the shared
    layout (a P0 file this batch may not touch) — injecting it through
    `yield :head` here is the sanctioned way to add a page-specific
    stylesheet without editing app/views/layouts/. %>
<% content_for :head do %>
  <%= stylesheet_link_tag "boss" %>
<% end %>

<header class="mx-auto! max-w-2xl! px-4! pt-8! text-center! sm:pt-12!">
  <h2 class="text-2xl! font-bold! text-slate-100!">魔王戰：<%= @question.title %></h2>
  <% if (phase_label = boss_phase_label(@question)) %>
    <p class="mt-1! text-sm! font-semibold! text-amber-400!"><%= phase_label %></p>
  <% end %>
</header>

<main class="mx-auto! max-w-2xl! px-4! pb-12! pt-6! text-center! sm:pb-16!"
      data-controller="boss-poll"
      data-boss-poll-url-value="<%= status_game_boss_path(@question.number) %>"
      data-boss-poll-score-url-value="<%= game_score_path %>"
      data-boss-poll-started-value="<%= @battle.started_at.present? %>"
      data-boss-poll-time-limit-value="<%= @time_limit %>"
      data-boss-poll-started-at-ms-value="<%= @battle.started_at.present? ? (@battle.started_at.to_f * 1000).to_i : 0 %>"
      data-boss-poll-attacks-url-value="<%= attacks_game_boss_path(@question.number) %>"
      data-boss-poll-is-netizen-value="<%= current_player.netizen? %>"
      data-boss-poll-skill-url-value="<%= skill_game_boss_path(@question.number) %>"
      data-boss-poll-job-value="<%= current_player.job %>"
      data-boss-poll-skill-available-value="<%= boss_skill_available?(@battle, current_player) %>"
      data-boss-poll-spotlight-active-value="<%= @battle.spotlight_active? %>">

  <% if flash[:alert] %>
    <div class="mb-4! rounded-lg! bg-rose-500/10! px-4! py-3! text-center! text-sm! text-rose-300! ring-1! ring-rose-500/30!" role="alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="mb-4! rounded-lg! bg-emerald-500/10! px-4! py-3! text-center! text-sm! text-emerald-300! ring-1! ring-emerald-500/30!" role="alert"><%= flash[:notice] %></div>
  <% end %>

  <% if @battle.ended_at.present? %>
    <div class="rounded-xl! bg-slate-800/80! p-6! text-slate-100! ring-1! ring-white/10! backdrop-blur!">
      <p>魔王已被擊敗！恭喜過關。</p>
      <% if (message = boss_defeat_message(@question)) %>
        <p class="mt-2! text-sm! text-amber-300!"><%= message %></p>
      <% end %>
      <%= link_to boss_defeat_link_label(@question), boss_defeat_next_path(@question), class: "mt-4! inline-flex! items-center! justify-center! rounded-lg! bg-amber-500! px-5! py-2.5! font-semibold! text-slate-900! transition! hover:bg-amber-400!" %>
    </div>
  <% elsif @battle.started_at.present? %>
    <div class="boss-bg" style="position: relative;" data-boss-poll-target="stage">
      <%= image_tag "bossGrass.png", class: "boss-grass" %>
      <% filename = boss_image_filename(@question) %>
      <button type="button"
              class="boss-hit <%= boss_sprite_css_classes(@question) %> boss"
              data-boss-poll-target="monster"
              data-action="click->boss-poll#attack"
              aria-label="攻擊<%= @question.title %>">
        <% if boss_asset_available?(filename) %>
          <%= image_tag filename, class: "boss-sprite", alt: @question.title %>
        <% else %>
          <span class="boss-sprite-fallback rounded-lg! bg-slate-800/90! px-4! py-2! text-sm! text-slate-100! ring-1! ring-white/10!">（本題王的立繪素材缺失：<%= filename %>）</span>
        <% end %>
      </button>
      <div class="boss-fx-layer" data-boss-poll-target="fx"></div>
      <div class="combo-counter" data-boss-poll-target="combo"></div>
    </div>

    <div id="bossHP" class="mx-auto! mt-4! h-4! w-full! max-w-md! overflow-hidden! rounded-full! bg-slate-700!">
      <div class="h-4! rounded-full! bg-emerald-500! transition-all!" role="progressbar" style="width: <%= @battle.hp_percent %>%;"
           data-boss-poll-target="hpBar" aria-valuenow="<%= @battle.hp_percent %>" aria-valuemin="0" aria-valuemax="100"></div>
    </div>
    <p class="mt-4! text-slate-100!">
      HP：<span data-boss-poll-target="hpText"><%= @battle.hp_percent %></span>%
      攻擊次數：<span data-boss-poll-target="attackCount"><%= @battle.attack_count %></span>
      剩餘時間：<span id="counter" data-boss-poll-target="counter"><%= @time_limit %></span> 秒
    </p>

    <p class="mt-6! text-sm! text-slate-300!">點擊怪物發動攻擊！弱點浮現時點中會爆擊。</p>

    <% if current_player.job.present? %>
      <div class="skill-card mt-6! rounded-xl! bg-slate-800/80! p-4! ring-1! ring-white/10! backdrop-blur!"
           data-boss-poll-target="skillCard">
        <h3 class="text-sm! font-bold! text-amber-400!"><%= job_label(current_player.job) %>・<%= job_skill_name(current_player.job) %></h3>
        <p class="mt-1! text-xs! text-slate-300!"><%= job_skill_description(current_player.job) %></p>
        <button type="button"
                class="skill-button mt-3! inline-flex! items-center! justify-center! rounded-lg! bg-amber-500! px-4! py-2! text-sm! font-semibold! text-slate-900! transition! hover:bg-amber-400! disabled:cursor-not-allowed! disabled:bg-slate-600! disabled:text-slate-400! cursor-pointer!"
                data-boss-poll-target="skillButton"
                data-action="click->boss-poll#activateSkill"
                <%= "disabled" unless boss_skill_available?(@battle, current_player) %>>
          <span data-boss-poll-target="skillButtonLabel"><%= boss_skill_available?(@battle, current_player) ? "發動技能" : "已使用" %></span>
        </button>
      </div>
    <% end %>
  <% else %>
    <div class="rounded-xl! bg-slate-800/80! p-6! text-slate-100! ring-1! ring-white/10! backdrop-blur!">
      <p>時限 <%= @time_limit %> 秒，全員宣戰後即開始攻擊！</p>
      <p class="mt-2! text-slate-300!">已宣戰：<span data-boss-poll-target="readyCount"><%= @battle.ready_count %></span>
         / <span data-boss-poll-target="readyTotal"><%= current_team.players.count %></span></p>
    </div>

    <%= button_to "宣戰！準備攻擊", ready_game_boss_path(@question.number), method: :post,
          class: "mt-6! inline-flex! items-center! justify-center! rounded-lg! bg-slate-700! px-6! py-3! text-lg! font-semibold! text-slate-100! ring-1! ring-white/10! transition! hover:bg-slate-600! cursor-pointer!" %>
  <% end %>

  <div class="mt-6!">
    <%= link_to "《返回遊戲地圖》", game_current_map_path, class: "text-sm! font-semibold! text-amber-400! transition! hover:text-amber-300!" %>
  </div>
</main>
