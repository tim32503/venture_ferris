<% content_for :title, "選擇職業" %>

<header class="text-center">
  <h2>選擇職業</h2>
</header>

<main class="container-fluid"
      data-controller="job-poll"
      data-job-poll-url-value="<%= game_job_status_path %>"
      data-job-poll-self-email-value="<%= current_player.email %>">

  <% if flash[:alert] %>
    <div class="alert alert-danger text-center" role="alert"><%= flash[:alert] %></div>
  <% end %>

  <% if current_player.job.present? %>
    <div class="dialog text-center">
      <p>您已選擇職業：<strong><%= job_label(current_player.job) %></strong></p>
    </div>
  <% else %>
    <div id="carouselJob" class="job-carousel" data-controller="carousel">
      <div class="job-carousel-track" data-carousel-target="track">
        <% Player.jobs.keys.each do |job| %>
          <div class="job-carousel-slide" data-carousel-target="slide" data-job-poll-target="jobCard" data-job="<%= job %>">
            <%= image_tag "#{job}.png", class: "d-block w-100", alt: job_label(job) %>
            <div class="job-carousel-caption">
              <h5><%= job_label(job) %></h5>
              <%= form_with url: game_job_path, method: :patch, local: true do |f| %>
                <%= f.hidden_field :job, value: job %>
                <%= f.submit "選擇#{job_label(job)}", class: "btn btn-success" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <button type="button" class="job-carousel-control prev" data-action="carousel#previous" aria-label="前一個">
        <span aria-hidden="true">&#10094;</span>
      </button>
      <button type="button" class="job-carousel-control next" data-action="carousel#next" aria-label="後一個">
        <span aria-hidden="true">&#10095;</span>
      </button>

      <div class="job-carousel-indicators">
        <% Player.jobs.keys.each_with_index do |job, index| %>
          <button type="button" class="job-carousel-dot <%= "active" if index.zero? %>"
                  data-carousel-target="indicator" data-action="carousel#goTo"
                  aria-label="<%= job_label(job) %>"></button>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="row text-center">
    <div class="col">
      <%= link_to "《前往主選單》", game_root_path, class: "btn btn-link" %>
    </div>
  </div>
</main>
