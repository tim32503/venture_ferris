<% content_for :title, "選擇職業" %>
<% content_for :body_class, "bg-gradient-to-b! from-slate-900 via-slate-900 to-slate-800 text-slate-100!" %>

<header class="mx-auto! max-w-2xl! px-4! pt-8! text-center! sm:pt-12!">
  <h2 class="text-2xl! font-bold! text-slate-100!">選擇職業</h2>
</header>

<main class="mx-auto! max-w-2xl! px-4! pb-12! pt-6! sm:pb-16!"
      data-controller="job-poll"
      data-job-poll-url-value="<%= game_job_status_path %>"
      data-job-poll-self-email-value="<%= current_player.email %>">

  <% if flash[:alert] %>
    <div class="mb-4! rounded-lg! bg-rose-500/10! px-4! py-3! text-center! text-sm! text-rose-300! ring-1! ring-rose-500/30!" role="alert"><%= flash[:alert] %></div>
  <% end %>

  <% if current_player.job.present? %>
    <div class="rounded-xl! bg-slate-800/80! p-6! text-center! ring-1! ring-white/10! backdrop-blur!">
      <p class="text-slate-200!">您已選擇職業：<strong class="text-amber-400!"><%= job_label(current_player.job) %></strong></p>
    </div>
  <% else %>
    <div id="carouselJob" class="job-carousel rounded-xl! bg-slate-800/80! p-4! ring-1! ring-white/10! backdrop-blur! sm:p-6!" data-controller="carousel">
      <div class="job-carousel-track" data-carousel-target="track">
        <% Player.jobs.keys.each do |job| %>
          <div class="job-carousel-slide" data-carousel-target="slide" data-job-poll-target="jobCard" data-job="<%= job %>">
            <%= image_tag "#{job}.png", class: "block! w-full! rounded-lg!", alt: job_label(job) %>
            <div class="job-carousel-caption">
              <h5 class="mb-2! text-lg! font-bold! text-slate-100!"><%= job_label(job) %></h5>
              <p class="mb-1! text-xs! text-slate-300!"><%= job_passive_description(job) %></p>
              <p class="mb-2! text-xs! text-amber-400!">主動：<%= job_skill_name(job) %>・<%= job_skill_description(job) %></p>
              <%= form_with url: game_job_path, method: :patch, local: true do |f| %>
                <%= f.hidden_field :job, value: job %>
                <%= f.submit "選擇#{job_label(job)}",
                      class: "inline-flex! items-center! justify-center! rounded-lg! bg-amber-500! px-5! py-2.5! font-semibold! text-slate-900! transition! hover:bg-amber-400! focus-visible:outline! focus-visible:outline-2! focus-visible:outline-offset-2! focus-visible:outline-amber-400! disabled:cursor-not-allowed! disabled:bg-slate-600! disabled:text-slate-400! cursor-pointer!" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <button type="button" class="job-carousel-control prev" data-action="carousel#previous" aria-label="前一個">
        <span aria-hidden="true">&#10094;</span>
      </button>
      <button type="button" class="job-carousel-control next" data-action="carousel#next" aria-label="後一個">
        <span aria-hidden="true">&#10095;</span>
      </button>

      <div class="job-carousel-indicators">
        <% Player.jobs.keys.each_with_index do |job, index| %>
          <button type="button" class="job-carousel-dot <%= "active" if index.zero? %>"
                  data-carousel-target="indicator" data-action="carousel#goTo"
                  aria-label="<%= job_label(job) %>"></button>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-6! text-center!">
    <%= link_to "《前往主選單》", game_root_path, class: "text-sm! font-semibold! text-slate-300! underline-offset-4! hover:text-slate-100! hover:underline!" %>
  </div>
</main>
