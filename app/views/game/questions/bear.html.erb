<% content_for :title, @question.title %>
<% content_for :body_class, "bg-gradient-to-b! from-slate-900 via-slate-900 to-slate-800 text-slate-100!" %>

<% content_for :head do %>
  <%# Page-scoped (legacy wheel_bear.php also kept its interaction CSS
      page-local rather than in the shared site.css) — see bear_controller.js.
      Hotspots are percentage-positioned <button>s inside a max-width
      container pinned to the source image's own pixel width, the same
      convention Game::MapsController's hotspots use (app/views/game/maps/
      show.html.erb) — so they track the responsive image at any viewport
      width instead of needing JS to recompute pixel geometry. %>
  <style>
    .bear-photo-wrap { position: relative; max-width: <%= @bear_image_natural_width %>px; margin: 0 auto; }
    .bear-hotspot { position: absolute; box-sizing: border-box; border-radius: 999px; border: 2px solid transparent; background: transparent; padding: 0; margin: 0; cursor: pointer; touch-action: manipulation; }
    .bear-hotspot.is-found { border-color: rgba(52, 211, 153, 0.9); background: rgba(52, 211, 153, 0.18); }
  </style>
<% end %>

<header class="mx-auto! max-w-2xl! px-4! pt-8! text-center! sm:pt-12!">
  <h2 class="text-2xl! font-bold! text-slate-100!"><%= @question.title %></h2>
</header>

<main class="mx-auto! max-w-2xl! px-4! pb-12! pt-6! sm:pb-16!">
  <% if flash[:alert] %>
    <div class="mb-4! rounded-lg! bg-rose-500/10! px-4! py-3! text-center! text-sm! text-rose-300! ring-1! ring-rose-500/30!" role="alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="mb-4! rounded-lg! bg-emerald-500/10! px-4! py-3! text-center! text-sm! text-emerald-300! ring-1! ring-emerald-500/30!" role="alert"><%= flash[:notice] %></div>
  <% end %>

  <% if @attempt.started_at.blank? %>
    <%= render "game/questions/start_dialog", question: @question %>
  <% else %>
    <div class="mb-4! rounded-xl! bg-slate-800/80! p-6! text-slate-100! ring-1! ring-white/10! backdrop-blur!"><%= @question.content %></div>

    <%# Bear questions are `interactive?` (Question#interactive?): finding
        all 5 hotspots below IS the answer, judged entirely client-side —
        there is no answer text, same trust model as the puzzle kind. %>
    <div data-controller="bear" data-bear-total-value="<%= @bear_hotspots.size %>">
      <div class="mb-4! rounded-xl! bg-slate-800/80! p-4! text-center! text-sm! text-slate-200! ring-1! ring-white/10!">
        <p>請點選與現場雕像相異之處，找出全部 <%= @bear_hotspots.size %> 處後，再點選下方按鈕確認答案。</p>
        <p class="mt-1!">僅限比對熊讚雕像本體，不用比對牠腳下的石頭唷！</p>
      </div>

      <div class="bear-photo-wrap">
        <%= image_tag question_image_filename(@question), class: "block! w-full!", alt: @question.title %>
        <% @bear_hotspots.each do |hotspot| %>
          <button type="button" class="bear-hotspot"
                  style="left: <%= hotspot[:left] %>%; top: <%= hotspot[:top] %>%; width: <%= hotspot[:width] %>%; height: <%= hotspot[:height] %>%;"
                  title="<%= hotspot[:label] %>" aria-label="<%= hotspot[:label] %>"
                  data-bear-hotspot-id="<%= hotspot[:id] %>"
                  data-bear-target="hotspot"
                  data-action="click->bear#hotspotClick"></button>
        <% end %>
      </div>

      <p data-bear-target="toast" aria-live="polite" class="mt-3! min-h-6! rounded-lg! bg-slate-800/80! px-4! py-2! text-center! text-sm! text-amber-300! ring-1! ring-white/10!"></p>

      <div class="mt-4! text-center!">
        <button type="button" style="display: none;" data-bear-target="confirmButton" data-action="click->bear#confirm"
                class="rounded-lg! bg-amber-500! px-5! py-2.5! font-semibold! text-slate-900! transition! hover:bg-amber-400! cursor-pointer!">
          確認找齊了嗎？
        </button>
      </div>

      <%= render "game/questions/hint_panel", question: @question, attempt: @attempt %>

      <%# Only exists for bear_controller.js's `confirm` handler to submit
          automatically once all 5 hotspots are found — no answer text to
          type, same pattern puzzle.html.erb uses for its own completion. %>
      <%= form_with url: answer_game_question_path(@question.number), method: :post, local: true, class: "hidden!" do |f| %>
        <%= f.submit "完成", data: { bear_target: "completeSubmit" } %>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6! text-center!">
    <%= link_to "《返回遊戲地圖》", game_current_map_path, class: "text-sm! font-semibold! text-amber-400! transition! hover:text-amber-300!" %>
  </div>
</main>
