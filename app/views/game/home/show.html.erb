<% content_for :title, "遊戲選單" %>
<% content_for :body_class, "bg-gradient-to-b! from-slate-900 via-slate-900 to-slate-800 text-slate-100!" %>

<header class="mx-auto! max-w-2xl! px-4! pt-8! text-center! sm:pt-12!">
  <h2 class="text-2xl! font-bold! text-slate-100!">遊戲選單</h2>
</header>

<div class="mx-auto! max-w-2xl! px-4!">
  <% if flash[:alert] %>
    <div class="mb-4! rounded-lg! bg-rose-500/10! px-4! py-3! text-center! text-sm! text-rose-300! ring-1! ring-rose-500/30!" role="alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="mb-4! rounded-lg! bg-emerald-500/10! px-4! py-3! text-center! text-sm! text-emerald-300! ring-1! ring-emerald-500/30!" role="alert"><%= flash[:notice] %></div>
  <% end %>
</div>

<%# The active-question poll anchors on question #1's status endpoint just to have a
    concrete URL to hit — questions#status answers with team-wide
    active_question_number info no matter which number is in the path. See
    active_question_poll_controller.js. Boss polling (legacy BossIsStart()) is now
    wired up (REFACTOR_PLAN.md P4) via the same endpoint's `active_boss_number`
    field and the controller's `bossBasePath` value, rather than a second
    data-controller. %>
<main class="mx-auto! max-w-2xl! px-4! pb-12! pt-6! sm:pb-16!"
      data-controller="active-question-poll dialog"
      data-active-question-poll-url-value="<%= status_game_question_path(Question::FIRST_NUMBER) %>"
      data-active-question-poll-question-base-path-value="<%= question_redirect_base_path %>"
      data-active-question-poll-boss-base-path-value="<%= boss_redirect_base_path %>">

  <div class="rounded-xl! bg-slate-800/80! p-6! text-center! ring-1! ring-white/10! backdrop-blur!">
    <% if current_team.test_mode? %>
      <span class="mb-2! inline-block! rounded! bg-amber-500/20! px-2! py-0.5! text-xs! font-semibold! text-amber-300! ring-1! ring-amber-500/40!">Demo</span>
    <% end %>
    <p class="text-slate-100!">冒險團：<strong class="text-amber-400!"><%= current_team.name || "尚未命名" %></strong></p>
    <p class="mt-1! text-slate-300!"><%= role_label(current_player.role) %>／<%= current_player.job.present? ? job_label(current_player.job) : "尚未選擇職業" %></p>
    <p class="mt-1! text-slate-300!">解謎進度：<%= @solved_count %> / <%= @total_questions %></p>
  </div>

  <div class="mt-6! flex! flex-col! gap-3!">
    <button class="inline-flex! items-center! justify-center! rounded-lg! bg-slate-700! px-5! py-2.5! font-semibold! text-slate-100! ring-1! ring-white/10! transition! hover:bg-slate-600! cursor-pointer!" data-action="dialog#open">玩法說明</button>
    <%= link_to "冒險隊伍", game_team_path, class: "inline-flex! items-center! justify-center! rounded-lg! bg-slate-700! px-5! py-2.5! font-semibold! text-slate-100! ring-1! ring-white/10! transition! hover:bg-slate-600!" %>
    <%= link_to "遊戲地圖", game_current_map_path, class: "inline-flex! items-center! justify-center! rounded-lg! bg-slate-700! px-5! py-2.5! font-semibold! text-slate-100! ring-1! ring-white/10! transition! hover:bg-slate-600!" %>
    <%# 積分紀錄／任務獎勵／登出遊戲: game/scores, game/rewards and
        game/sessions#destroy all shipped in REFACTOR_PLAN.md's P4 batch. %>
    <%= link_to "積分紀錄", game_score_path, class: "inline-flex! items-center! justify-center! rounded-lg! bg-slate-700! px-5! py-2.5! font-semibold! text-slate-100! ring-1! ring-white/10! transition! hover:bg-slate-600!" %>
    <%= link_to "任務獎勵", game_reward_path, class: "inline-flex! items-center! justify-center! rounded-lg! bg-slate-700! px-5! py-2.5! font-semibold! text-slate-100! ring-1! ring-white/10! transition! hover:bg-slate-600!" %>
    <%= button_to "登出遊戲", game_session_path, method: :delete,
                   class: "w-full! inline-flex! items-center! justify-center! rounded-lg! bg-slate-700! px-5! py-2.5! font-semibold! text-slate-100! ring-1! ring-white/10! transition! hover:bg-slate-600! cursor-pointer!",
                   form: { data: { turbo_confirm: "確定要登出嗎？" } } %>
  </div>

  <dialog class="native-modal rounded-xl! bg-slate-800! p-0! text-slate-100! ring-1! ring-white/10! shadow-2xl!" style="max-width:32rem;width:90%;" data-dialog-target="dialog" data-action="click->dialog#closeOnBackdrop" aria-labelledby="descModalLabel">
    <div class="native-modal-header flex! items-center! justify-between! border-b! border-white/10! px-4! py-3!">
      <h5 class="native-modal-title text-lg! font-bold! text-slate-100!" id="descModalLabel">玩法說明</h5>
      <button type="button" class="close text-2xl! leading-none! text-slate-400! transition! hover:text-slate-100! cursor-pointer!" data-action="dialog#close" aria-label="Close">
        <span aria-hidden="true">&times;</span>
      </button>
    </div>

    <div class="native-modal-body p-4! text-center!">
      <%= image_tag "description.png", class: "mx-auto! max-w-full! rounded-lg!" %>
    </div>
  </dialog>
</main>
