<% content_for :title, "冒險隊伍" %>

<header class="container">
  <h2 class="text-center">冒險隊伍</h2>
</header>

<div class="container-fluid">
  <% if flash[:alert] %>
    <div class="alert alert-danger text-center" role="alert"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="alert alert-success text-center" role="alert"><%= flash[:notice] %></div>
  <% end %>
</div>

<main class="container-fluid"
      data-controller="team-poll"
      data-team-poll-url-value="<%= game_team_status_path %>"
      data-team-poll-redirect-on-ready-value="<%= current_team.name.blank? %>"
      data-team-poll-redirect-url-value="<%= game_job_path %>">

  <% if current_team.name.blank? %>
    <% if current_player.leader? %>
      <div class="dialog">
        <p>團長，請先為您的冒險團取個響亮的團名吧！（2~10字以內，限中文、英文、數字）</p>
        <%= form_with url: game_team_path, method: :patch, local: true do |f| %>
          <div class="input-group mb-3">
            <%= f.text_field :name, class: "form-control", placeholder: "請輸入團名", "aria-label": "請輸入團名", maxlength: 10 %>
            <div class="input-group-append">
              <%= f.submit "確認", class: "btn btn-dark" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-center">冒險者請留步，稍後將帶您前往新手村進行轉職！</p>
    <% end %>
  <% else %>
    <table class="table text-center">
      <thead>
        <tr class="table-secondary"><th>冒險團名</th></tr>
      </thead>
      <tbody>
        <tr><td data-team-poll-target="name"><%= current_team.name %></td></tr>
      </tbody>
    </table>

    <table class="table text-center">
      <thead>
        <tr class="table-secondary">
          <th colspan="3">冒險團員（<span data-team-poll-target="count"><%= current_team.players.count %></span> 人）</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th>類型</th>
          <th>職業</th>
          <th>遊戲帳號</th>
        </tr>
        <% current_team.players.order(:role).each do |player| %>
          <tr>
            <td><%= role_label(player.role) %></td>
            <td><%= player.job.present? ? job_label(player.job) : "未選擇" %></td>
            <td><%= player.email %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if current_team.name.present? && current_player.job.blank? %>
    <div class="row text-center mb-2">
      <div class="col">
        <%= link_to "《前往新手村轉職（選擇職業）》", game_job_path, class: "btn btn-dark" %>
      </div>
    </div>
  <% end %>

  <div class="row text-center">
    <div class="col">
      <%= link_to "《返回遊戲選單》", game_root_path, class: "btn btn-link" %>
    </div>
  </div>
</main>
