<% content_for :title, "積分結算" %>

<header class="container">
  <h2 class="text-center">積分結算</h2>
</header>

<main class="container-fluid">
  <% if flash[:notice] %>
    <div class="alert alert-success text-center" role="alert"><%= flash[:notice] %></div>
  <% end %>

  <% if @entries.empty? %>
    <p class="dialog text-center">尚未有任何題目完成結算，請先擊敗魔王！</p>
  <% else %>
    <table class="table text-center">
      <thead>
        <tr class="table-secondary">
          <th>題號</th>
          <th>基礎分</th>
          <th>時間分</th>
          <th>提示分</th>
          <th>魔王分</th>
          <th>職業分</th>
          <th>小計</th>
        </tr>
      </thead>
      <tbody>
        <% @entries.each do |entry| %>
          <tr>
            <td><%= entry.question_number %></td>
            <td><%= entry.question_score %></td>
            <td><%= entry.time_score %></td>
            <td><%= entry.hint_score %></td>
            <td><%= entry.boss_score %></td>
            <td><%= entry.job_score %></td>
            <td><strong><%= entry.total_score %></strong></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="table-dark">
          <td colspan="6">總分</td>
          <td><strong><%= @total %></strong></td>
        </tr>
      </tfoot>
    </table>
  <% end %>

  <div class="row text-center">
    <div class="col">
      <%= link_to "《返回遊戲選單》", game_root_path, class: "btn btn-link" %>
    </div>
  </div>
</main>
