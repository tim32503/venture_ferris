<% content_for :title, "隊伍詳情" %>
<% content_for :body_class, "bg-slate-50! bg-none! text-slate-800!" %>
<% content_for :footer_class, "text-slate-400!" %>

<main class="[text-shadow:none]! mx-auto! max-w-6xl! px-4! py-8! sm:py-12! flex! flex-col! gap-6! sm:flex-row!">
  <%= render "admin/nav" %>

  <div class="min-w-0! flex-1!">
    <%= render "admin/header", title: "隊伍詳情 — #{@team.serial_no}" %>

    <%= link_to "← 回隊伍列表", admin_teams_path, class: "mb-6! inline-block! text-sm! font-semibold! text-indigo-600! hover:text-indigo-500!" %>

    <div class="mb-8! rounded-xl! bg-white! p-6! ring-1! ring-slate-200! shadow-sm!">
      <h2 class="text-base! font-semibold! text-slate-800!">基本資料</h2>
      <dl class="mt-4! grid! grid-cols-2! gap-4! text-sm! sm:grid-cols-4!">
        <div>
          <dt class="text-slate-500!">序號</dt>
          <dd class="font-semibold! text-slate-800!"><%= @team.serial_no %></dd>
        </div>
        <div>
          <dt class="text-slate-500!">隊名</dt>
          <dd class="font-semibold! text-slate-800!"><%= @team.name.presence || "（未命名）" %></dd>
        </div>
        <div>
          <dt class="text-slate-500!">test_mode</dt>
          <dd class="font-semibold! text-slate-800!"><%= @team.test_mode? ? "是" : "否" %></dd>
        </div>
        <div>
          <dt class="text-slate-500!">解題進度</dt>
          <dd class="font-semibold! text-slate-800!"><%= @team.solved_count %> / <%= Question::LAST_NUMBER %></dd>
        </div>
      </dl>

      <% if @team.test_mode? %>
        <div class="mt-6!">
          <%= button_to "刪除此測試隊伍", admin_team_path(@team), method: :delete,
                data: { turbo_confirm: "確定要刪除測試隊伍 #{@team.serial_no} 嗎？此操作將一併清除隊員、解題紀錄、戰鬥紀錄與分數，且無法復原。" },
                class: "cursor-pointer! rounded-lg! bg-rose-600! px-4! py-2! text-sm! font-semibold! text-white! transition! hover:bg-rose-500!" %>
        </div>
      <% else %>
        <p class="mt-6! text-sm! text-slate-500!">正式隊伍不提供刪除（營運資料保護）。</p>
      <% end %>
    </div>

    <div class="mb-8! overflow-x-auto! rounded-xl! bg-white! ring-1! ring-slate-200!">
      <h2 class="px-4! pt-4! text-base! font-semibold! text-slate-800!">隊員</h2>
      <table class="mt-2! min-w-full! divide-y! divide-slate-200! text-sm!">
        <thead class="bg-slate-50!">
          <tr>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">角色</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">職業</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">姓名</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">Email</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">手機</th>
          </tr>
        </thead>
        <tbody class="divide-y! divide-slate-100!">
          <% @players.each do |player| %>
            <tr>
              <td class="px-4! py-3! text-slate-700!"><%= player.leader? ? "隊長" : "隊員" %></td>
              <td class="px-4! py-3! text-slate-700!"><%= player.job&.humanize || "（未選擇）" %></td>
              <td class="px-4! py-3! text-slate-700!"><%= player.name.presence || "—" %></td>
              <td class="px-4! py-3! text-slate-700!"><%= mask_email(player.email) %></td>
              <td class="px-4! py-3! text-slate-700!"><%= mask_mobile(player.mobile) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mb-8! overflow-x-auto! rounded-xl! bg-white! ring-1! ring-slate-200!">
      <h2 class="px-4! pt-4! text-base! font-semibold! text-slate-800!">解題紀錄</h2>
      <table class="mt-2! min-w-full! divide-y! divide-slate-200! text-sm!">
        <thead class="bg-slate-50!">
          <tr>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">題號</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">耗時（秒）</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">提示數</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">完成時間</th>
          </tr>
        </thead>
        <tbody class="divide-y! divide-slate-100!">
          <% @question_attempts.each do |attempt| %>
            <tr>
              <td class="px-4! py-3! text-slate-700!">第 <%= attempt.question.number %> 題</td>
              <td class="px-4! py-3! text-slate-700!"><%= attempt.elapsed_seconds || "—" %></td>
              <td class="px-4! py-3! text-slate-700!"><%= attempt.hint_count %></td>
              <td class="px-4! py-3! text-slate-700!"><%= attempt.ended_at&.strftime("%Y-%m-%d %H:%M") || "未完成" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mb-8! overflow-x-auto! rounded-xl! bg-white! ring-1! ring-slate-200!">
      <h2 class="px-4! pt-4! text-base! font-semibold! text-slate-800!">Boss 戰紀錄</h2>
      <table class="mt-2! min-w-full! divide-y! divide-slate-200! text-sm!">
        <thead class="bg-slate-50!">
          <tr>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">題號</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">攻擊次數 / HP</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">狀態</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">結束時間</th>
          </tr>
        </thead>
        <tbody class="divide-y! divide-slate-100!">
          <% @boss_battles.each do |battle| %>
            <tr>
              <td class="px-4! py-3! text-slate-700!">第 <%= battle.question.number %> 題</td>
              <td class="px-4! py-3! text-slate-700!"><%= battle.attack_count %> / <%= battle.hp %></td>
              <td class="px-4! py-3! text-slate-700!"><%= battle.defeated? ? "已擊敗" : "進行中" %></td>
              <td class="px-4! py-3! text-slate-700!"><%= battle.ended_at&.strftime("%Y-%m-%d %H:%M") || "—" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="mb-8! overflow-x-auto! rounded-xl! bg-white! ring-1! ring-slate-200!">
      <h2 class="px-4! pt-4! text-base! font-semibold! text-slate-800!">分數明細</h2>
      <table class="mt-2! min-w-full! divide-y! divide-slate-200! text-sm!">
        <thead class="bg-slate-50!">
          <tr>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">題號</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">題目分</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">時間分</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">提示分</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">Boss 分</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">職業加成</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">總分</th>
          </tr>
        </thead>
        <tbody class="divide-y! divide-slate-100!">
          <% @score_entries.each do |entry| %>
            <tr>
              <td class="px-4! py-3! text-slate-700!">第 <%= entry.question.number %> 題</td>
              <td class="px-4! py-3! text-slate-700!"><%= entry.question_score %></td>
              <td class="px-4! py-3! text-slate-700!"><%= entry.time_score %></td>
              <td class="px-4! py-3! text-slate-700!"><%= entry.hint_score %></td>
              <td class="px-4! py-3! text-slate-700!"><%= entry.boss_score %></td>
              <td class="px-4! py-3! text-slate-700!"><%= entry.job_score %></td>
              <td class="px-4! py-3! font-semibold! text-slate-800!"><%= entry.total_score %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="overflow-x-auto! rounded-xl! bg-white! ring-1! ring-slate-200!">
      <h2 class="px-4! pt-4! text-base! font-semibold! text-slate-800!">兌獎序號配發狀態</h2>
      <table class="mt-2! min-w-full! divide-y! divide-slate-200! text-sm!">
        <thead class="bg-slate-50!">
          <tr>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">序號</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">test_mode</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">配發對象</th>
            <th class="px-4! py-3! text-left! font-semibold! text-slate-600!">配發時間</th>
          </tr>
        </thead>
        <tbody class="divide-y! divide-slate-100!">
          <% if @reward_codes.empty? %>
            <tr><td class="px-4! py-3! text-slate-500!" colspan="4">尚未配發</td></tr>
          <% end %>
          <% @reward_codes.each do |reward_code| %>
            <tr>
              <td class="px-4! py-3!"><code class="text-slate-700!"><%= reward_code.code %></code></td>
              <td class="px-4! py-3! text-slate-700!"><%= reward_code.test_mode? ? "是" : "否" %></td>
              <td class="px-4! py-3! text-slate-700!"><%= mask_email(reward_code.player_email) %></td>
              <td class="px-4! py-3! text-slate-700!"><%= reward_code.claimed_at&.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</main>
