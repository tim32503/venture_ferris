<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">後台 Dashboard</h1>
    <%= button_to "登出", admin_session_path, method: :delete, class: "btn btn-outline-secondary btn-sm" %>
  </div>

  <% if flash[:notice] %>
    <div class="alert alert-info"><%= flash[:notice] %></div>
  <% end %>

  <div class="row text-center mb-4">
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h2 class="display-4"><%= @team_count %></h2>
          <p class="text-muted mb-0">隊伍數</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h2 class="display-4"><%= @player_count %></h2>
          <p class="text-muted mb-0">玩家數</p>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card">
        <div class="card-body">
          <h2 class="display-4"><%= @claimed_reward_code_count %></h2>
          <p class="text-muted mb-0">已配發獎品序號數</p>
        </div>
      </div>
    </div>
  </div>

  <%= link_to "序號產生器", admin_serial_codes_path, class: "btn btn-primary" %>
</div>
