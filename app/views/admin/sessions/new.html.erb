<div class="container mt-5" style="max-width: 420px;">
  <h1 class="h3 mb-4">後台登入</h1>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>
  <% if flash[:notice] %>
    <div class="alert alert-info"><%= flash[:notice] %></div>
  <% end %>

  <%= form_with url: admin_session_path, method: :post, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email, "帳號 (Email)" %>
      <%= f.email_field :email, class: "form-control", required: true, autofocus: true %>
    </div>

    <div class="form-group">
      <%= f.label :password, "密碼" %>
      <%= f.password_field :password, class: "form-control", required: true %>
    </div>

    <%= f.submit "登入", class: "btn btn-primary btn-block" %>
  <% end %>
</div>
